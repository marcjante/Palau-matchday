# Clave compartida que debe mandar el frontend en la cabecera X-API-Key.
# OBLIGATORIO definirla en producción (si se deja vacía, la API queda sin protección).
API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Por defecto usa SQLite local (./hcpalau.db). En producción en la nube,
# usa la cadena de conexión de Postgres que te da Railway/Render, con este formato:
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=sqlite:///./hcpalau.db

# Tamaño del modelo Whisper para transcripción de audio en el servidor:
# tiny (más rápido) | base (equilibrio) | small (más preciso, más lento)
WHISPER_MODEL_SIZE=base
